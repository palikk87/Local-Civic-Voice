###############################################################################
# Civic Voice — every environment variable, in one file.
#
# There are three deploy targets and each takes a different slice of this list:
#
#   [API]     the backend (Railway, Fly, Render, or any container host)
#   [WEB]     apps/web (Vercel, Netlify, Cloudflare Pages, or static hosting)
#   [MOBILE]  apps/mobile (baked into the build by EAS, not set at runtime)
#
# Plus one that is not a deploy target at all:
#
#   [SEED]    set in the shell for a one-off seed script, then removed. Nothing
#             reads these at runtime, so setting them on a host does nothing.
#
# Each variable below is tagged. Copy the tagged lines into that platform's
# environment settings; do not commit a filled-in copy of this file.
#
# Two rules this codebase enforces:
#
#   1. Nothing has a fallback that points somewhere different from what you
#      asked for. A missing value fails the boot loudly. This is deliberate — a
#      silent `file:` SQLite fallback once stood in for a missing Postgres URL,
#      and the server looked healthy while every account was written to storage
#      that was about to be deleted.
#
#   2. No account identifiers live in the repo. Project refs, org IDs, bucket
#      names, and hostnames all arrive through these variables, which is what
#      lets you move any one of these services without editing code.
###############################################################################


# ─────────────────────────────────────────────────────────────────────────────
# Database — any Postgres
# ─────────────────────────────────────────────────────────────────────────────
# Plain Postgres, reached over a connection string. Nothing in this codebase
# uses provider-specific features, so this can be Supabase, Neon, RDS, Railway's
# own Postgres, or a server you run. Moving providers is changing these two
# lines.
#
# On Supabase these are, in the dashboard, Project Settings → Database:
#   DATABASE_URL  → "Transaction pooler"  (port 6543)
#   DIRECT_URL    → "Direct connection"   (port 5432)
#
# Both are needed. Migrations issue session-level statements that a transaction
# pooler rejects, so `prisma migrate deploy` runs over DIRECT_URL while the
# server runs over the pooled one.

# [API]
DATABASE_URL=postgresql://user:password@host:6543/postgres
# [API]
DIRECT_URL=postgresql://user:password@host:5432/postgres


# ─────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────

# [API] Public URL of the API itself. Used to build absolute links.
BACKEND_URL=https://api.example.com

# [API] "production" on a deployment. Anything else enables dev behaviour,
# including localhost origins being trusted.
NODE_ENV=production

# [API] The port the server binds to.
#
# backend/Dockerfile sets PORT=3000, so it is never actually unset when running
# from that image — which means a host that routes to a different port needs
# this set to match. On Railway, the service's "target port" and this value must
# agree or the proxy returns 502 on a server that started perfectly.
PORT=3000

# [API] Long random string signing session cookies. Generate with:
#         openssl rand -base64 32
# Changing it invalidates every existing session.
BETTER_AUTH_SECRET=

# [API] Comma-separated web origins allowed to make credentialed requests.
# Feeds BOTH the CORS allowlist and Better Auth's trustedOrigins, from one
# place — they used to be two hand-maintained lists, and an origin present in
# one but not the other produced a login that failed with no useful error.
# Include every hostname the site answers on, apex and www alike.
APP_ORIGINS=https://civicvoice.app,https://www.civicvoice.app

# [API] Comma-separated deep-link schemes for the native app. Must match
# `expo.scheme` in apps/mobile/app.json and the `scheme` passed to expoClient()
# in apps/mobile/src/lib/auth/auth-client.ts. If these three disagree, sign-in
# on a real device fails silently.
APP_SCHEMES=civicvoice


# ─────────────────────────────────────────────────────────────────────────────
# Media storage — any S3-compatible bucket
# ─────────────────────────────────────────────────────────────────────────────
# User photos and videos are the one thing in this app that cannot be
# regenerated from an upstream source. They must not live on the container's
# filesystem: on a redeploy the files vanish while the database rows keep
# pointing at them.
#
# "s3" here means the S3 API, not Amazon. The same settings work for Cloudflare
# R2, Backblaze B2, MinIO on your own server, DigitalOcean Spaces, Wasabi, AWS
# S3, or Supabase Storage's S3 endpoint. Switching between them is editing these
# variables.

# [API] "s3" for any deployment. "local" writes to UPLOADS_DIR — dev only.
MEDIA_STORAGE=s3

# [API] Bucket name.
S3_BUCKET=civicvoice-media

# [API] S3 API endpoint for your provider. Examples:
#   Cloudflare R2   https://<account-id>.r2.cloudflarestorage.com
#   Backblaze B2    https://s3.us-west-004.backblazeb2.com
#   AWS S3          https://s3.us-east-1.amazonaws.com
#   Supabase        https://<project-ref>.supabase.co/storage/v1/s3
S3_ENDPOINT=

# [API] Region. R2 ignores it — use "auto" there.
S3_REGION=auto

# [API] Bucket credentials. Scope them to this bucket only; they are not the
# same thing as an account-wide API token, and should never be one.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# [API] "true" for MinIO and most self-hosted gateways, which address buckets as
# <endpoint>/<bucket>/<key> rather than as a subdomain. Leave unset for R2 and
# AWS.
# S3_FORCE_PATH_STYLE=false

# [API] Where browsers load the files from, if that differs from S3_ENDPOINT —
# a CDN or a custom domain in front of the bucket. Optional. The bucket must be
# publicly readable either way; this app does not issue signed read URLs.
# MEDIA_PUBLIC_URL=https://media.civicvoice.app

# [API] Only used when MEDIA_STORAGE=local.
# UPLOADS_DIR=/data/uploads


# ─────────────────────────────────────────────────────────────────────────────
# Transactional email (Resend)
# ─────────────────────────────────────────────────────────────────────────────
# Carries sign-in codes and password-reset codes. Without it, nobody who forgets
# a password can recover their account.

# [API]
RESEND_API_KEY=

# [API] Must be a verified sender on a domain you control in Resend. An
# unverified domain fails delivery even with a valid key, and the failure is
# only visible in Resend's dashboard.
# Until a real domain is verified, Resend's shared test sender works and needs no
# DNS at all — but it delivers ONLY to the email address the Resend account was
# opened with. Good enough to prove the reset flow works; not good enough to ship.
EMAIL_FROM=Civic Voice <onboarding@resend.dev>


# ─────────────────────────────────────────────────────────────────────────────
# Government data sources
# ─────────────────────────────────────────────────────────────────────────────
# These populate GovernmentReference — the bills, executive orders and court
# cases that are the product's actual content. The sync runs at boot and daily.
#
# Federal Register (executive orders) needs no key and is not listed here.

# [API] Free. Request at https://api.congress.gov/sign-up/ — arrives by email,
# usually within a minute. Without it, bills do not sync.
CONGRESS_API_KEY=

# [API] Free. Create an account at https://www.courtlistener.com/ then generate
# a token under Profile → API. Without it, SCOTUS cases do not sync.
COURTLISTENER_API_KEY=

# [API] Optional. Adds live web-search grounding to legislative search; without
# it search falls back to unaided AI interpretation. https://tavily.com
TAVILY_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# B2B analytics portal seeding
# ─────────────────────────────────────────────────────────────────────────────
# Two logins for the business dashboard at /b2b.
#
# NOT RUNTIME CONFIGURATION. The API does not read any of these. They are read
# by backend/scripts/seed-b2b.ts, which you run once against a new database; it
# hashes them and writes two rows to the B2BClient table, and the API verifies
# against those rows from then on. Same arrangement as the admin seeding block
# below.
#
# If you had these set as service variables from an earlier version, the server
# no longer needs them and will not complain either way. Remove them once the
# seed has run.
#
# There is deliberately no default. These were literals in
# backend/src/routes/b2b.ts, in a public repository, and one pair granted the
# superadmin tier — reading the file was enough to own the dashboard. The script
# fails and names every one it is missing rather than substituting anything.
#
# The two passwords: anything a password manager generates. Nothing here needs
# to be memorable or typed by a human twice.
#
# The two API keys are the machine alternative to username/password, sent as
# `Authorization: ApiKey <value>`. Generate each with:
#
#   openssl rand -base64 48
#
# Their length is load-bearing in a way the passwords' is not. An API key is
# stored as a plain SHA-256 digest, with no key-stretching, because it has to be
# looked up by that digest — so being unguessable is the entire defence. The
# script warns if either is under 32 characters.
#
# To rotate any of this later: change the value and run the script again.

# [SEED] Standard analytics login.
B2B_DEMO_USERNAME=
B2B_DEMO_PASSWORD=
B2B_DEMO_API_KEY=

# [SEED] Superadmin login. Same dashboard, highest tier — treat with the care
# that implies, and do not reuse a password from anywhere else. Its API key must
# differ from the demo one; the script refuses if they match.
B2B_ADMIN_USERNAME=
B2B_ADMIN_PASSWORD=
B2B_ADMIN_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# Admin seeding
# ─────────────────────────────────────────────────────────────────────────────
# Read by backend/scripts/seed-admin.ts, which you run once against a new
# database. Not read by the server at runtime — set them for that one command
# and then remove them.

# [SEED] All three are required by the script.
ADMIN_EMAIL=
# [SEED]
ADMIN_USERNAME=
# [SEED]
ADMIN_PASSWORD=
# [SEED] Optional; defaults to ADMIN_USERNAME.
# ADMIN_NAME=


# ─────────────────────────────────────────────────────────────────────────────
# Web build
# ─────────────────────────────────────────────────────────────────────────────
# Vite inlines VITE_* at BUILD time, not at runtime. A build cannot be promoted
# from staging to production — changing this value requires a rebuild.

# [WEB] Where the browser reaches the API. If you use the same-origin proxy in
# apps/web/vercel.json (or its equivalent on another host), this is your own
# domain plus /api and cookies stay first-party.
VITE_BACKEND_URL=https://civicvoice.app/api


# ─────────────────────────────────────────────────────────────────────────────
# Mobile build
# ─────────────────────────────────────────────────────────────────────────────
# Expo inlines EXPO_PUBLIC_* into the bundle at build time. Setting it at
# runtime has no effect; a release build with this missing throws at startup
# rather than sending requests to a malformed URL.

# [MOBILE]
EXPO_PUBLIC_BACKEND_URL=https://api.civicvoice.app

# [MOBILE] Optional. Only used by the legacy client-side Congress.gov lookup in
# lib/congress-api.ts; the backend does its own syncing with CONGRESS_API_KEY.
# EXPO_PUBLIC_CONGRESS_API_KEY=
