# Mobile app (Expo). Copy to .env and fill in.
#
# WARNING: every EXPO_PUBLIC_* value is compiled into the app bundle shipped to
# every phone. Anything here is public. Never put a service_role key or any
# server-side secret in this file.

# --------------------------------------------------------------------------
# Backend
# --------------------------------------------------------------------------
# URL of the Hono backend in this repo. Was EXPO_PUBLIC_VIBECODE_BACKEND_URL;
# the code still falls back to that name so existing builds keep working.
EXPO_PUBLIC_BACKEND_URL=http://localhost:3000

# --------------------------------------------------------------------------
# Supabase
# --------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# The ANON key. This slot previously held a service_role key — a full-admin
# credential — which was therefore shipped inside the app bundle. Use the anon
# key only. Get it from:
#   Supabase dashboard -> Settings -> API -> Project API keys -> anon
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Master switch. Leave unset/false to keep using Better Auth + the Hono backend.
# Set to true ONLY once the Supabase project above responds — it swaps auth over
# to Supabase, so enabling it against a dead host locks everyone out of login.
EXPO_PUBLIC_SUPABASE_ENABLED=false

# --------------------------------------------------------------------------
# Third-party APIs
# --------------------------------------------------------------------------
# Free key: https://api.congress.gov/sign-up/
EXPO_PUBLIC_CONGRESS_API_KEY=

# NOTE: the old exports also carried EXPO_PUBLIC_VIBECODE_{OPENAI,ANTHROPIC,
# GROK,GOOGLE,ELEVENLABS}_API_KEY. No code in this repo reads them — they fed
# Vibecode's AI proxy — so they are intentionally not listed here. AI calls go
# through the backend, which holds its own keys server-side.
