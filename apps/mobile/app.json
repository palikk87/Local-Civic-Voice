{
  "expo": {
    "name": "AYE & NAY",
    "slug": "ayeandnay",
    "scheme": "ayeandnay",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ayeandnay.app"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.ayeandnay.app"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
