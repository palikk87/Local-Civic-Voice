# Web app (Vite). Copy to .env and fill in.
#
# WARNING: every VITE_* value is compiled into the JavaScript bundle the browser
# downloads. Anything here is public. Never put a service_role key or any
# server-side secret in this file.

# Congress.gov API key — lets the Citizen's Brief fetch real bill text.
VITE_CONGRESS_API_KEY=

# --------------------------------------------------------------------------
# Supabase
# --------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# The ANON key — the one meant for clients. It is constrained by row-level
# security policies. Get it from:
#   Supabase dashboard -> Settings -> API -> Project API keys -> anon
VITE_SUPABASE_ANON_KEY=

# Master switch. Leave unset/false to keep using Better Auth + the Hono backend.
# Set to true ONLY once the Supabase project above responds — it swaps auth over
# to Supabase, so enabling it against a dead host locks everyone out of login.
VITE_SUPABASE_ENABLED=false
