generator client {
  provider = "prisma-client-js"
}

// This file is the single source of truth for the database.
//
// There is exactly one migration, generated from this schema. A brand new empty
// Postgres is brought to the full schema by `prisma migrate deploy` and nothing
// else — no baseline file, no `migrate resolve`, no manual SQL.
//
// DATABASE_URL is the pooled connection the server uses. DIRECT_URL is the
// unpooled one Prisma needs for migrations. Neither has a fallback: if they are
// unset the process fails at startup rather than connecting to somewhere
// unexpected. See src/env.ts.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String  @id @default(cuid())
  name          String
  username      String? @unique
  email         String  @unique
  emailVerified Boolean @default(false)
  role          String  @default("user")
  image         String?
  bio           String?
  /// Free text on the profile card. Display only — never parsed, never counted.
  /// The structured jurisdiction is the two columns below.
  location      String?

  // ---------------------------------------------------------------------
  // JURISDICTION — where this person's voice belongs, and nothing more.
  //
  // Bill of Rights Article IV: "AYE & NAY shall collect only the minimum data
  // necessary to verify citizenship AND JURISDICTION." Jurisdiction is named
  // there as a legitimate purpose, so this is authorised — and the same
  // sentence caps it, so this is where the collection stops. There is no
  // street, no ZIP kept after it has been resolved, no coordinates, no IP.
  //
  // OPTIONAL, AND NEVER REQUIRED TO VOTE. Article I holds that the power of the
  // vote originates in the individual; making a ballot conditional on handing
  // over an address would be exactly the lock-in that article forbids. Somebody
  // who declines still votes, and their voice still counts in the national
  // Pulse. It simply cannot be placed on a map, which is the truth and is what
  // the map says.
  //
  // SELF-DECLARED, NOT INFERRED. Nothing geolocates anybody. The person picks
  // their district from the real congress.gov roster and can see their
  // representative's name while doing it, which is both a confirmation for them
  // and the reason no guess is needed.
  // ---------------------------------------------------------------------

  /// Two-letter state, e.g. "CA". Null until the person says.
  stateCode         String?
  /// "CA-12", or "AK-AL" for an at-large seat. Null until the person says, and
  /// null for somebody who gave a state but not a district.
  districtId        String?
  /// When they last set it. A district that has not been confirmed since the
  /// last redistricting is a district that may now be wrong.
  jurisdictionSetAt DateTime?

  // Moderation state. Read and written by the admin console (routes/admin.ts).
  //
  // These columns previously existed only to stop a boot-time
  // `prisma db push --accept-data-loss` from dropping them: two projects shared
  // one database and each push deleted whatever was missing from its own
  // schema. That is how 423 rows of `banned` were destroyed on 2026-08-08.
  // Neither the shared database nor the push survives, so these are now
  // ordinary columns that ordinary code uses.
  //
  // `banExpiresAt` null means permanent. Expiry is evaluated on read rather
  // than swept by a job — see isCurrentlyBanned() in routes/admin.ts.
  banned          Boolean   @default(false)
  banReason       String?
  banExpiresAt    DateTime?
  bannedAt        DateTime?
  /// Username of the admin who applied the ban, copied in rather than joined so
  /// the record survives that admin being renamed or removed.
  bannedBy        String?
  displayUsername String?

  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  accounts               Account[]
  comments               Comment[]
  delegationsReceived    Delegation[]              @relation("DelegationTo")
  delegationsGiven       Delegation[]              @relation("DelegationFrom")
  followers              Follow[]                  @relation("Following")
  following              Follow[]                  @relation("Follower")
  posts                  Post[]
  sessions               Session[]
  votes                  Vote[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  conversations          ConversationParticipant[]
  messagesSent           Message[]
  commentLikes           CommentLike[]
  blocksMade             Block[]                   @relation("Blocker")
  blocksReceived         Block[]                   @relation("Blocked")
  mutesMade              Mute[]                    @relation("Muter")
  mutesReceived          Mute[]                    @relation("Muted")
  reportsFiled           Report[]                  @relation("Reporter")
  reportsAbout           Report[]                  @relation("ReportedUser")
  positionEvents         PositionEvent[]

  // Article V. Impeachment does not touch the account — see the model below.
  impeachmentsAgainst Impeachment[]        @relation("ImpeachmentLeader")
  impeachmentsFiled   Impeachment[]        @relation("ImpeachmentFiler")
  impeachmentVotes    ImpeachmentElector[]

  // Article III §2. Kept only to rate-limit re-running the same audit; the
  // audit itself never carries who asked for it.
  auditsRequested IntegrityAudit[] @relation("IntegrityAuditRequester")
  // Article IV. Every summons this person was ever sent, answered or not, and
  // every jury that has heard a report about them.
  jurySeats       JurySeat[]
  juriesAccusedIn Jury[]           @relation("JuryAccused")

  // Aggregating the Pulse by geography is the whole purpose of the two
  // jurisdiction columns above, and it is a grouped count over the whole table.
  @@index([stateCode])
  @@index([districtId])
}

model AdminSession {
  token     String   @id
  adminId   String
  username  String
  role      String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([adminId])
  @@index([expiresAt])
}

/// Accounts for the B2B analytics portal.
///
/// Was a hardcoded fixture array in routes/b2b.ts. Two credentials live here,
/// stored differently on purpose:
///
///   passwordHash — scrypt, via better-auth/crypto, same as every other password
///   in this system. Passwords are low-entropy and human-chosen, so the defence
///   against an offline attack on a leaked dump is the KDF being slow.
///
///   apiKeyHash — SHA-256 of a high-entropy key the operator generated. NOT a
///   KDF, deliberately. A KDF cannot be looked up, so hashing an API key that
///   way turns every ApiKey request into a full table scan running scrypt once
///   per row. A key with 256 bits of entropy is not brute-forceable regardless,
///   so the KDF's slowness buys nothing and costs a scan. A digest is
///   non-reversible, unique, and indexed — one equality lookup per request.
///
/// `username` is stored lowercased; login lowercases before matching, which
/// preserves the case-insensitive behaviour the fixture array had.
model B2BClient {
  id       String @id @default(cuid())
  username String @unique
  name     String

  /// The citizen account this business account was created for, when it was
  /// created by converting one. Null for a client minted from nothing.
  ///
  /// A LINK, NOT A TRANSFORMATION. Converting somebody does not consume their
  /// citizen account: their votes, posts and civic record stay exactly where
  /// they were and keep belonging to them. This column exists so the admin
  /// console can say which account a client came from, and so one person
  /// cannot quietly end up behind two business accounts.
  ///
  /// Deliberately NOT a foreign key with a cascade. If the person ever closes
  /// their citizen account, the business account and everything billed against
  /// it must not vanish with it — the company is not the person. The link goes
  /// stale and reads as null-ish, which is the truth.
  userId       String?   @unique
  /// research | media | campaign | government
  type         String
  /// basic | professional | enterprise
  tier         String
  passwordHash String
  /// SHA-256 hex digest of the API key. Unique, so it is an indexed lookup.
  apiKeyHash   String    @unique
  /// Last successful login. Written at login only, not per request — a write on
  /// every authenticated call would be pointless contention on one row.
  lastAccessAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Sessions for the B2B analytics portal.
///
/// Mirrors AdminSession, for the same reason: this was a module-level Map in
/// routes/b2b.ts, so every redeploy signed out every business customer with no
/// warning and the API could never run more than one instance.
///
/// Denormalised on purpose — clientName and tier are copied in rather than
/// joined, because the B2B client list is not a table yet. When it becomes one,
/// these become a relation.
model B2BSession {
  token      String   @id
  clientId   String
  clientName String
  /// basic | professional | enterprise
  tier       String
  /// The B2BMember this session belongs to, or null when the account's own
  /// username (or an API key) was used — that login is the owner.
  memberId   String?
  /// owner | admin | analyst, copied at login. Copied rather than joined so an
  /// authorisation check is the same single row read every other B2B request
  /// already does; a role change takes effect at the seat holder's next login,
  /// or immediately if the change revokes their sessions, which demoting and
  /// disabling both do.
  memberRole String?
  memberName String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([clientId])
  @@index([expiresAt])
  @@index([memberId])
}

/// Site-wide notices written by an admin and read by both clients.
///
/// This was a module-level array. Every restart silently emptied it while the
/// admin console went on presenting announcements as published — the same class
/// of bug as admin sessions living in a Map, which is why that moved to
/// AdminSession above.
model Announcement {
  id        String    @id @default(cuid())
  title     String
  content   String
  /// low | medium | high | critical
  priority  String    @default("medium")
  createdBy String
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  isActive  Boolean   @default(true)

  @@index([isActive, createdAt])
  @@index([expiresAt])
}

/// Audit trail of admin actions.
///
/// An audit log that does not survive a restart is worse than none: it reads as
/// a complete record of who did what, and is not one. Kept deliberately denormalised
/// — adminUsername is copied in rather than joined, so the log still reads correctly
/// after an admin account is renamed or deleted.
model AdminActivityLog {
  id            String   @id @default(cuid())
  action        String
  adminId       String
  adminUsername String
  /// user | post | comment | system
  targetType    String
  targetId      String?
  details       String
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([adminId])
  @@index([targetType, targetId])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Post {
  id                    String               @id @default(cuid())
  content               String
  authorId              String
  billId                String?
  governmentReferenceId String? // Link to canonical GovernmentReference
  referenceType         String? // bill, executive_order, scotus_case (for backwards compat)
  referenceId           String? // ID of the referenced law/case/order (for backwards compat)
  referenceTitle        String? // Title of the referenced law (for backwards compat)
  /// The post this one passes on, if it is a repost.
  ///
  /// A repost with empty content is a plain "here, read this". A repost with
  /// content is a quote — the reposter's own words above somebody else's post.
  /// Both point at the same place, because the difference is what the reposter
  /// wrote, not what kind of record it is.
  ///
  /// Never points at another repost: reposting a repost points at the original,
  /// so a chain cannot form and a post's repost count is the number of people
  /// who passed it on rather than the depth of a game of telephone.
  repostOfId            String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  comments              Comment[]
  repostOf              Post?                @relation("Reposts", fields: [repostOfId], references: [id], onDelete: Cascade)
  reposts               Post[]               @relation("Reposts")
  bill                  Bill?                @relation(fields: [billId], references: [id])
  governmentReference   GovernmentReference? @relation("GovernmentReferencePosts", fields: [governmentReferenceId], references: [id])
  author                User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes                 PostLike[]
  saves                 PostSave[]
  shares                PostShare[]
  media                 Media[]

  @@index([authorId])
  @@index([billId])
  @@index([governmentReferenceId])
  @@index([referenceType])
  @@index([referenceId])
  @@index([createdAt])
  @@index([repostOfId])
}

model Media {
  id           String   @id @default(cuid())
  postId       String?
  userId       String
  type         String // image, video, audio
  url          String
  thumbnailUrl String?
  mimeType     String
  sizeBytes    Int
  durationMs   Int? // For video/audio
  width        Int? // For images/video
  height       Int? // For images/video
  createdAt    DateTime @default(now())
  post         Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  @@index([createdAt])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@index([createdAt]) // Index for recent likes queries
}

model Comment {
  id        String        @id @default(cuid())
  content   String
  postId    String
  authorId  String
  parentId  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[]     @relation("CommentReplies")
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  likes     CommentLike[]

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Bill {
  id             String    @id @default(cuid())
  title          String
  summary        String
  fullText       String?
  category       String
  status         String
  chamber        String
  sponsor        String?
  cosponsors     String?
  introducedDate DateTime?
  lastActionDate DateTime?
  lastAction     String?
  sourceUrl      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  posts          Post[]
  votes          Vote[]

  @@index([category])
  @@index([status])
  @@index([createdAt])
}

model Vote {
  id        String   @id @default(cuid())
  billId    String
  userId    String
  position  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bill      Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([billId, userId])
  @@index([billId])
  @@index([userId])
  @@index([userId, billId, position]) // Compound index for similarity calculations
}

model Delegation {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  category   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  toUser     User     @relation("DelegationTo", fields: [toUserId], references: [id], onDelete: Cascade)
  fromUser   User     @relation("DelegationFrom", fields: [fromUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId, category])
  @@index([fromUserId])
  @@index([toUserId])
}

// Social Feed Algorithm Models

// Tracks all user interactions for feed personalization
model UserInteraction {
  id              String   @id @default(cuid())
  userId          String
  postId          String?
  targetUserId    String? // For follows, profile views
  interactionType String // view, like, comment, share, save, follow, mention, dwell
  dwellTimeMs     Int? // Time spent viewing (for view interactions)
  metadata        String? // JSON string for additional context
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([postId])
  @@index([targetUserId])
  @@index([interactionType])
  @@index([createdAt])
  @@index([userId, interactionType, createdAt]) // Compound index for user preference queries
  @@index([postId, interactionType]) // Compound index for post metric calculations
}

// Aggregated metrics for content creators (updated periodically)
model CreatorMetrics {
  id                 String   @id @default(cuid())
  userId             String   @unique
  totalFollowers     Int      @default(0)
  totalLikes         Int      @default(0)
  totalComments      Int      @default(0)
  totalShares        Int      @default(0)
  totalMentions      Int      @default(0)
  totalPosts         Int      @default(0)
  avgEngagementRate  Float    @default(0) // (likes + comments + shares) / followers
  viralPostCount     Int      @default(0) // Posts that exceeded 10x avg engagement
  influenceScore     Float    @default(0) // Calculated influence score
  followerGrowthRate Float    @default(0) // 7-day growth rate
  activeFollowerPct  Float    @default(0) // % of followers who engage
  topCategories      String? // JSON array of top content categories
  peakPostingHours   String? // JSON array of optimal posting times
  lastCalculated     DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([influenceScore])
  @@index([totalFollowers])
  @@index([avgEngagementRate])
  @@index([influenceScore, totalFollowers]) // Compound index for creator ranking
}

// Post engagement metrics (updated in real-time)
model PostMetrics {
  id                  String    @id @default(cuid())
  postId              String    @unique
  viewCount           Int       @default(0)
  uniqueViewers       Int       @default(0)
  likeCount           Int       @default(0)
  commentCount        Int       @default(0)
  shareCount          Int       @default(0)
  saveCount           Int       @default(0)
  avgDwellTimeMs      Int       @default(0)
  engagementRate      Float     @default(0)
  viralityScore       Float     @default(0) // Engagement velocity
  qualityScore        Float     @default(0) // Based on engagement quality
  firstHourEngagement Int       @default(0) // Early signal for viral potential
  peakEngagementHour  DateTime?
  lastEngagementAt    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([viralityScore])
  @@index([engagementRate])
  @@index([createdAt])
  @@index([viralityScore, createdAt]) // Compound index for trending queries
  @@index([lastEngagementAt]) // Index for recent activity queries
}

// User feed preferences and behavior patterns
model UserFeedProfile {
  id                  String    @id @default(cuid())
  userId              String    @unique
  preferredCategories String? // JSON array of category weights
  preferredAuthors    String? // JSON array of author IDs with weights
  interactionPatterns String? // JSON object of behavior patterns
  avgSessionDuration  Int       @default(0)
  postsPerSession     Int       @default(0)
  likeRate            Float     @default(0) // % of viewed posts liked
  commentRate         Float     @default(0) // % of viewed posts commented
  shareRate           Float     @default(0) // % of viewed posts shared
  peakActivityHours   String? // JSON array of active hours
  contentPreferences  String? // JSON: {textLength, hasImage, hasBill, etc}
  diversityPreference Float     @default(0.5) // 0 = echo chamber, 1 = diverse
  lastActiveAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([lastActiveAt])
}

// Stores post saves/bookmarks
model PostSave {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@index([postId])
  @@index([createdAt]) // Index for recent saves queries
}

// Stores post shares
model PostShare {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  shareType String   @default("internal") // internal, external, dm
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  @@index([createdAt])
}

// User mentions in posts/comments
model Mention {
  id                String   @id @default(cuid())
  mentionedUserId   String
  mentionedByUserId String
  postId            String?
  commentId         String?
  createdAt         DateTime @default(now())

  @@index([mentionedUserId])
  @@index([mentionedByUserId])
  @@index([postId])
  @@index([createdAt])
}

// Hashtag tracking
model Hashtag {
  id            String    @id @default(cuid())
  tag           String    @unique
  useCount      Int       @default(0)
  trendingScore Float     @default(0)
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([trendingScore])
  @@index([useCount])
}

model PostHashtag {
  id        String   @id @default(cuid())
  postId    String
  hashtagId String
  createdAt DateTime @default(now())

  @@unique([postId, hashtagId])
  @@index([postId])
  @@index([hashtagId])
}

// Notification System Models

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // like, comment, reply, mention, follow, repost, new_follower_post
  title     String
  body      String
  data      String? // JSON string for additional context (postId, commentId, fromUserId, etc.)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@index([type])
}

model NotificationPreference {
  id               String  @id @default(cuid())
  userId           String  @unique
  likes            Boolean @default(true)
  comments         Boolean @default(true)
  replies          Boolean @default(true)
  mentions         Boolean @default(true)
  follows          Boolean @default(true)
  reposts          Boolean @default(true)
  newFollowerPosts Boolean @default(true)
  /// "Somebody sent you a message." On by default: a direct message that
  /// notifies nobody is only ever seen if the recipient happens to open the
  /// inbox, which makes the inbox useless for anything time-sensitive.
  messages         Boolean @default(true)
  // "A law you shared has been updated." On by default: somebody who put their
  // name to a position on a bill has a stake in knowing the bill moved, and a
  // silent change is how a person ends up standing behind text they never read.
  lawUpdates       Boolean @default(true)
  /// "Somebody voted in your name." On by default, and it should stay that
  /// way: a delegation the delegator never hears about is a voice given away
  /// rather than lent, and this platform's Constitution says political power
  /// here is only ever borrowed. Borrowed means you are told when it is used.
  voiceUsed        Boolean @default(true)
  /// NOT A NOTIFICATION — a ranking choice, kept here because this is where a
  /// citizen's feed preferences already live.
  ///
  /// Bill of Rights Article II says only the verifiable weight of Liquid
  /// Democracy should decide prominence. The feed reserves up to a fifth of
  /// itself for people who voted the opposite way on a record you also voted
  /// on, and however good the intent, that is the platform prioritising a
  /// segment by viewpoint. Article II does not leave room for the platform to
  /// make that call — but it does say the platform is "a neutral conduit for
  /// human intent", and a citizen choosing it for themselves is human intent.
  /// So it is a switch, disclosed, and the platform never touches it.
  showOtherSide    Boolean @default(true)
  /// Bill of Rights Article IV: vote anonymously by default.
  ///
  /// Applied by the server when a vote does not say either way, so the right
  /// is exercisable from every surface that can cast a vote rather than only
  /// the ones that grew a toggle. A single request can still override it in
  /// both directions.
  ///
  /// Off by default. Anonymity has to be chosen — a platform that quietly
  /// anonymised everybody would be making the choice for them just as surely
  /// as one that never offered it.
  voteAnonymously  Boolean @default(false)

  /// Whether this person has ever been ASKED the question above.
  ///
  /// Without this, "chose to be named" and "never knew there was a choice"
  /// are the same row. The switch lived only in Settings, so anybody who
  /// never opened Settings had been putting their name on public positions
  /// without being told. False here means nobody has asked: the first time
  /// they vote, the app asks, stores the answer in voteAnonymously, sets this,
  /// and never asks again.
  voteAnonymityChosen Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Government Reference System - Canonical reference for bills, executive orders, and SCOTUS cases
model GovernmentReference {
  id                  String    @id @default(cuid())
  masterReferenceId   String    @unique
  referenceType       String
  title               String
  shortTitle          String?
  sourceUrl           String?
  chamber             String?
  congress            Int?
  status              String
  category            String?
  description         String?
  citizenBrief        String?
  // Retired. These held a fabricated tally — a few thousand invented supporters
  // per record, derived from a hash of its id, so a new card would not read
  // 0-0 — and it was added into the public number this platform exists to
  // report. Zeroed by migration, no longer written by anything, and kept only
  // because dropping a column is not an additive change.
  seedSupport         Int       @default(0)
  seedOppose          Int       @default(0)
  fullText            String?
  citizenBriefJson    String?
  citizenBriefAt      DateTime?
  citizenBriefModel   String?
  // Which version of the law the stored brief was written for.
  //
  // A brief is expensive and it is written about one text. Without this, "does
  // the brief still describe this law" is answered by transient in-process
  // state, so a regeneration that failed once leaves a stale brief looking
  // current forever. Comparing this to lawVersion makes "one brief per version"
  // something the code can check rather than something it intends.
  citizenBriefVersion Int?
  fullTextSource      String?
  fullTextUrl         String?
  fullTextHash        String?
  fullTextAt          DateTime?
  sourceCheckedAt     DateTime?
  // When the LAW changed, as opposed to when the row was written.
  //
  // `updatedAt` moves every time somebody votes, so it cannot answer "has this
  // law moved since I shared it" — which is the question a badge on a post and
  // a notification to its author both depend on. This is set only when the
  // official source reports something genuinely different: a new title, a new
  // status, or text that no longer hashes the same.
  lawChangedAt        DateTime?
  // Increments alongside lawChangedAt. The citizen brief is written for one
  // version of a law and reused until this number moves, which is what makes
  // "one brief per version" a fact rather than an intention.
  lawVersion          Int       @default(1)
  contentStatus       String?
  // When the current contentStatus started, for the two working states only.
  //
  // "fetching" and "brief_pending" describe work in flight, and work in flight
  // ends — but nothing was writing down when it began, so a job lost to a
  // restart, a crash, or a deploy left the row claiming to be busy forever.
  // The reader then watched a spinner that could never resolve, and a reload
  // did not help because the lie was stored, not local.
  //
  // With a start time, "busy" is checkable: past the timeout it is abandoned
  // work, not current work, and the next reader is offered the button again.
  contentStartedAt    DateTime?
  signedDate          DateTime?
  decidedDate         DateTime?

  // ---------------------------------------------------------------------
  // WHEN THIS ACTUALLY HAPPENED, from the source rather than from us.
  //
  // These did not exist. reference-mappers.ts filled introducedDate and
  // lastActionDate with `ref.createdAt` — the moment OUR row was written — so
  // a law from 2007 displayed as introduced today, and every record on the
  // platform appeared to be from the day we happened to sync it. A date is a
  // fact about the legislation, not about our database.
  // ---------------------------------------------------------------------

  /// The day it was introduced, per congress.gov. Null when unknown.
  introducedDate DateTime?
  /// The day of the most recent action, per congress.gov.
  lastActionDate DateTime?
  /// What that action was, in the chamber's own words.
  lastActionText String?

  // ---------------------------------------------------------------------
  // WHO SPONSORED IT — a member, not a chamber.
  //
  // The mapper invented "U.S. House of Representatives / Independent - US"
  // with a blank avatar for every bill, because there was nowhere to put a
  // sponsor. Bills are sponsored by a person, and congress.gov names them.
  // ---------------------------------------------------------------------

  /// Bioguide id, so the sponsor joins the roster the Delegates screen uses.
  sponsorBioguideId String?
  sponsorName       String?
  /// "D", "R", "I" — the letter the roster uses.
  sponsorParty      String?
  /// Two-letter state.
  sponsorState      String?
  aliases           String?
  mergedIntoId      String?
  supportVotes      Int      @default(0)
  opposeVotes       Int      @default(0)
  totalComments     Int      @default(0)
  totalShares       Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  mergedInto        GovernmentReference?      @relation("MergedReferences", fields: [mergedIntoId], references: [id])
  mergedFrom        GovernmentReference[]     @relation("MergedReferences")
  posts             Post[]                    @relation("GovernmentReferencePosts")
  votes             GovernmentReferenceVote[]
  rollCalls         RollCall[]
  positionEvents    PositionEvent[]
  names             ReferenceName[]
  candidatesAsLeft  ReferenceMergeCandidate[] @relation("MergeCandidateLeft")
  candidatesAsRight ReferenceMergeCandidate[] @relation("MergeCandidateRight")

  @@index([referenceType])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  // Sorting by when a law was actually introduced, now that we know.
  @@index([introducedDate])
  @@index([supportVotes])
  @@index([opposeVotes])
  @@index([mergedIntoId])
}

// ---------------------------------------------------------------------------
// Every name a record has ever answered to.
//
// A master reference id is permanent in intent but not in fact: a mangled id
// gets repaired, two records merge and one name survives, Congress renumbers a
// measure. Each of those rewrites a name that is already out in the world — in
// a shared link, a bookmark, a client that cached it. This table is what makes
// "no link ever dies" true rather than aspirational.
//
// `name` is unique across every record on purpose. One name means one piece of
// government business; two records claiming the same name is not a state to
// support, it is a duplicate to resolve, and the constraint is what surfaces it
// instead of letting lookups silently pick one.
//
// The `aliases` JSON column on GovernmentReference is now a derived mirror of
// the former names here, kept only because the search that has not been rebuilt
// yet does a LIKE against it. This table is the authority.
// ---------------------------------------------------------------------------

model ReferenceName {
  id          String   @id @default(cuid())
  name        String   @unique
  referenceId String
  // Exactly one name per record is the one it is called now; the rest are the
  // names it used to be called.
  isCurrent   Boolean  @default(false)
  // How this name was learned: created, backfilled, repaired, merged,
  // renumbered, manual. An audit trail for a rename is only useful if it says
  // what caused it.
  learnedFrom String
  firstSeenAt DateTime @default(now())

  reference GovernmentReference @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  @@index([referenceId])
  @@index([referenceId, isCurrent])
}

// ---------------------------------------------------------------------------
// Two records that might be one law.
//
// Congress.gov publishes, for every bill, which other bills it is related to
// and how — "Identical bill", "Companion measure", "Related bill",
// "Procedurally-related" — along with who made that call: the House, the
// Senate, or the Congressional Research Service. That is the government's own
// lineage data, and it is the only evidence good enough to join two records
// without a person looking.
//
// Only "Identical bill" is acted on automatically. That label means a Library
// of Congress analyst read both texts and confirmed they match. Every other
// relationship lands here as a question for a human, with the government's page
// attached and the name of whoever made the call.
//
// "Related bill" never becomes a candidate at all. Related means a different
// law on the same subject, which is the opposite of a duplicate.
//
// Look-alike title suggestions also land here, clearly marked as carrying no
// authority — they exist because a load test found 7 of 13 stored bills have no
// published lineage whatsoever.
// ---------------------------------------------------------------------------

model ReferenceMergeCandidate {
  id String @id @default(cuid())

  // Ordered so the same pair is always the same row: leftId sorts before
  // rightId. Without that, A-B and B-A are two rows and the unique constraint
  // stops meaning anything.
  leftId  String
  rightId String

  // The government's own label, or "look_alike" for a title suggestion this
  // platform generated and nobody official stands behind.
  relationship String
  // House, Senate, or CRS. Null for a look-alike, which is the point.
  identifiedBy String?
  // The congress.gov page a reviewer can open to check the claim.
  evidenceUrl  String?
  // Title similarity, 0 to 1. Only set on look-alikes.
  similarity   Float?

  // pending, approved, rejected, superseded
  status      String    @default("pending")
  decidedById String?
  decidedAt   DateTime?
  // Why a reviewer rejected it, so the same pair is not re-litigated monthly.
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  left  GovernmentReference @relation("MergeCandidateLeft", fields: [leftId], references: [id], onDelete: Cascade)
  right GovernmentReference @relation("MergeCandidateRight", fields: [rightId], references: [id], onDelete: Cascade)

  @@unique([leftId, rightId])
  @@index([status])
  @@index([leftId])
  @@index([rightId])
}

// Votes on government references (separate from bill votes)
model GovernmentReferenceVote {
  id                    String              @id @default(cuid())
  governmentReferenceId String
  userId                String
  position              String // support, oppose
  /// Bill of Rights Article IV names an anonymous voting option as a right,
  /// and there was no such column: every position was attributable to a named
  /// account, permanently and publicly.
  ///
  /// THE VOTE STILL COUNTS. It is carried into the Pulse exactly like any
  /// other, including through delegation — anonymity withholds the NAME, never
  /// the voice. Article I's promise that the Pulse is the aggregate of verified
  /// citizens and Article IV's promise of anonymity are only compatible if the
  /// tally is blind to this flag, so it is.
  isAnonymous           Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  governmentReference   GovernmentReference @relation(fields: [governmentReferenceId], references: [id], onDelete: Cascade)

  @@unique([governmentReferenceId, userId])
  @@index([governmentReferenceId])
  @@index([userId])
  @@index([position])
}

// ---------------------------------------------------------------------------
// Direct messaging.
//
// Replaces the in-memory mock that routes/messages.ts used to serve, which had
// a hardcoded "current_user" and lost everything on restart.
//
// Read state lives on ConversationParticipant.lastReadAt rather than a per-row
// isRead flag: marking a conversation read is then one UPDATE instead of one
// per message, and unread counts stay correct no matter how far behind a
// participant is. The API still exposes a per-message isRead, computed from the
// relevant participant's lastReadAt.
// ---------------------------------------------------------------------------

model Conversation {
  id           String                    @id @default(cuid())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]

  // Conversation lists are ordered by most recent activity.
  @@index([updatedAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One row per user per conversation; also the lookup for "is this user a
  // participant", which every message endpoint checks before authorizing.
  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // Paging a thread is (conversationId, createdAt) ordered.
  @@index([conversationId, createdAt])
  @@index([senderId])
}

/// A like on a comment.
///
/// The comment UI has rendered a filled or empty heart from `comment.isLiked`
/// since before this table existed, which meant the heart was decoration: it
/// could never be filled, and pressing it changed nothing anybody else saw.
model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

/// One person refusing to deal with another.
///
/// A block is mutual in effect and one-sided in intent: the blocker stops
/// seeing the blocked person, and the blocked person stops being able to reach
/// the blocker. Follows in both directions are severed when it is created,
/// because a block that leaves a follow in place is not a block.
///
/// Deliberately not exposed to the person blocked. They are not told, and
/// nothing in any response says "you have been blocked" — that is an invitation
/// to make a new account, and the point is to end contact quietly.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

/// Quieter than a block: their posts leave your feed and nothing else changes.
///
/// They can still follow you, message you, and reply to you, and they are never
/// told. This is the option for somebody you do not want to read but do not
/// want to make a decision about.
model Mute {
  id        String   @id @default(cuid())
  muterId   String
  mutedId   String
  createdAt DateTime @default(now())
  muter     User     @relation("Muter", fields: [muterId], references: [id], onDelete: Cascade)
  muted     User     @relation("Muted", fields: [mutedId], references: [id], onDelete: Cascade)

  @@unique([muterId, mutedId])
  @@index([muterId])
  @@index([mutedId])
}

/// Somebody telling the moderators about a post, a comment, or a person.
///
/// Exactly one target is set. Kept rather than acted on automatically: a report
/// is evidence for a human, and a platform that hides content on report alone
/// hands anybody with a grudge a delete button.
model Report {
  id             String    @id @default(cuid())
  reporterId     String
  postId         String?
  commentId      String?
  reportedUserId String?
  reason         String
  detail         String?
  /// open, actioned, dismissed
  status         String    @default("open")
  /// Username of the admin who closed it, copied in so the record survives
  /// that admin being renamed or removed.
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())

  reporter     User  @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User? @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  /// Article IV. The jury hearing this report, once one has been drawn.
  jury         Jury?

  @@index([status])
  @@index([reporterId])
  @@index([postId])
  @@index([reportedUserId])
}

/// One moment a person took a position, kept forever.
///
/// GovernmentReferenceVote holds where somebody stands NOW: one row per person
/// per record, overwritten when they change their mind. That is the right shape
/// for a tally and the wrong shape for a record of a citizen, because it means
/// the platform cannot answer the question a citizen most wants answered about
/// themselves — what did I say, and when, and about which version of the law.
///
/// This is append-only. Nothing here is ever updated or deleted while the
/// account exists. Changing your mind adds a row; it does not erase one.
///
/// WHY THE LAW VERSION IS ON IT. The text under a position moves. Somebody who
/// backed a bill in March did not back what it says in August, and treating
/// those as the same position is how a person ends up publicly behind text they
/// never read. Storing the version the position was taken on is what makes
/// "this law has changed since you backed it" answerable at all.
model PositionEvent {
  id                    String   @id @default(cuid())
  userId                String
  governmentReferenceId String
  /// support, oppose, or withdrawn
  position              String
  /// GovernmentReference.lawVersion at the moment this was taken.
  lawVersion            Int      @default(1)
  /// Why they changed their mind, when they chose to say. Never required —
  /// a reason people are forced to give is a reason people invent.
  reason                String?
  /// True when this position replaced an earlier one on the same record.
  isChange              Boolean  @default(false)
  /// Carried from the vote. The record is kept either way — a citizen can
  /// always read their own history — but an anonymous position is withheld
  /// from every surface that would attach their name to it for somebody else.
  isAnonymous           Boolean  @default(false)
  createdAt             DateTime @default(now())

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  governmentReference GovernmentReference @relation(fields: [governmentReferenceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([governmentReferenceId])
  @@index([userId, governmentReferenceId])
}

/// A recorded vote of the House or Senate on one measure.
///
/// THE MISSING HALF OF THE REPRESENTATION GAP. The platform could say "73% of
/// citizens here oppose this" and had nothing to compare it against, because
/// nothing stored how Congress actually voted. `officialVotes` on the bill
/// card was never set by anything and the PulseGap component had never
/// rendered for a real record.
///
/// Sourced from senate.gov and clerk.house.gov, which publish every roll call
/// as XML with NO API KEY. This was previously written up as blocked on a
/// congress.gov key; it never needed one.
model RollCall {
  id         String @id @default(cuid())
  /// "house" or "senate".
  chamber    String
  congress   Int
  /// Senate sessions are 1 or 2; the House numbers rolls per calendar year.
  session    Int
  /// Roll number within the chamber's numbering for that session/year.
  rollNumber Int
  /// The calendar year the House filed it under. Null for Senate rolls.
  year       Int?

  /// As printed by the chamber — "H R 4058", "S.J.Res. 82".
  legisNumber           String?
  /// The canonical record this belongs to, when it could be resolved.
  masterReferenceId     String?
  governmentReferenceId String?

  question    String
  /// "Passed", "Failed", "Agreed to", "Joint Resolution Defeated (50-50)".
  result      String
  /// The chamber's own description of the measure.
  description String?
  votedAt     DateTime

  yea       Int
  nay       Int
  present   Int @default(0)
  notVoting Int @default(0)

  /// Where this came from, so any number here is traceable to an official page.
  sourceUrl String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  governmentReference GovernmentReference? @relation(fields: [governmentReferenceId], references: [id], onDelete: SetNull)
  memberVotes         RollCallMemberVote[]

  @@unique([chamber, congress, session, rollNumber])
  @@index([governmentReferenceId])
  @@index([masterReferenceId])
  @@index([votedAt])
}

/// How one member of Congress voted on one roll call.
///
/// This is the half that makes the gap personal — "here is how YOUR
/// representative voted" — and the reason member ids are kept: bioguide for
/// the House, LIS for the Senate, both stable and both the official ids.
model RollCallMemberVote {
  id         String @id @default(cuid())
  rollCallId String

  /// Bioguide id (House) or LIS member id (Senate).
  memberId  String
  lastName  String
  firstName String?
  party     String
  state     String
  /// The district for a House member; null for a senator.
  district  String?
  /// "Yea", "Nay", "Present", "Not Voting" — the chamber's own wording.
  voteCast  String

  rollCall RollCall @relation(fields: [rollCallId], references: [id], onDelete: Cascade)

  @@unique([rollCallId, memberId])
  @@index([memberId])
  @@index([state, district])
}

/// What a merge did, in enough detail to undo it.
///
/// MERGING USED TO BE ONE-WAY, which is the real reason it needed a human
/// standing in front of it. A wrong merge pooled two different laws' votes
/// into one number permanently, and the duplicate votes it deleted were gone.
/// With that true, "ask an admin" was the only responsible answer.
///
/// This makes it reversible, and that is what makes automating the decision
/// safe rather than reckless. A machine may now act on evidence, because a
/// mistake is a button rather than a corrupted record.
model MergeJournal {
  id       String @id @default(cuid())
  sourceId String
  targetId String

  /// How the decision was made: "congress_identical", "same_text",
  /// "ai_adjudicated", or "admin".
  decidedBy   String
  /// The reasoning, in words, whoever or whatever decided.
  reason      String
  /// A page a human can open to check the claim.
  evidenceUrl String?
  /// The model's confidence, when a model decided. Null otherwise.
  confidence  Float?

  /// Votes DELETED by the merge — people who had voted on both records, whose
  /// duplicate was spent. Stored whole, because there is nothing else left of
  /// them to restore from.
  deletedVotes    String @default("[]")
  /// Votes whose position was overwritten by a later one from the source, and
  /// what they said before.
  supersededVotes String @default("[]")

  /// Counter deltas the survivor absorbed, so they can be given back.
  commentsAbsorbed Int     @default(0)
  sharesAbsorbed   Int     @default(0)
  /// Whether the survivor adopted the source's brief or official text.
  adoptedBrief     Boolean @default(false)
  adoptedText      Boolean @default(false)

  /// Set when this merge has been undone, so a journal is never replayed twice.
  revertedAt   DateTime?
  revertedBy   String?
  revertReason String?

  createdAt DateTime @default(now())

  rows MergeJournalRow[]

  @@index([sourceId])
  @@index([targetId])
  @@index([decidedBy])
  @@index([revertedAt])
}

/// One row a merge moved, and where it came from.
///
/// Cheaper and safer than storing a bag of ids on the journal: this survives a
/// record with tens of thousands of votes, and it says per row where it
/// belongs if the merge is undone.
model MergeJournalRow {
  id        String @id @default(cuid())
  journalId String
  /// The Prisma model name: Post, GovernmentReferenceVote, PositionEvent,
  /// RollCall, SystemResetJournalVote.
  model     String
  rowId     String

  journal MergeJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([journalId, model])
}

/// A bug report from somebody using the app.
///
/// Named BugReport rather than Report because Report already means "this post
/// breaks the rules" — a moderation queue, a different inbox, and a different
/// urgency. Two things called the same word in one schema is how the wrong
/// queue gets checked.
model BugReport {
  id       String  @id @default(cuid())
  /// Null for a signed-out visitor. A bug that only strangers hit is still a bug.
  userId   String?
  /// Copied in rather than joined, so the report survives the account closing.
  username String?

  /// Where they were when it happened.
  pageUrl  String
  pagePath String

  /// What they pointed at. Null when they wrote a note without picking anything.
  /// A short human description ("the Vote Nay button"), not a selector — the
  /// selector is in `elementPath` for whoever has to find it.
  elementLabel String?
  elementPath  String?

  /// WHAT IT ACTUALLY IS, as opposed to what it said.
  ///
  /// elementLabel is the word on the screen, which is the right thing to show
  /// the person reporting and the one thing the admin already had — it is in
  /// the complaint. This carries the identity: the component that rendered it,
  /// the record it was showing (data-* attributes from the element and its
  /// ancestors), a selector that finds it again, where the control leads, and
  /// the markup with typed-in values removed.
  ///
  /// JSON because the shape differs by platform and will grow: the web reads a
  /// DOM, and mobile has none to read.
  elementDetail Json?

  /// Their words, in two parts, because "what is wrong" and "what would be
  /// right" are different questions and the second one is the useful one.
  problem String
  wanted  String?

  /// Set by the app, not typed: browser, viewport, and the commit being served.
  /// A bug report without these costs a round trip to become actionable.
  userAgent String?
  viewport  String?
  appCommit String?

  /// open | acknowledged | fixed | declined
  status     String    @default("open")
  /// Free text from whoever triaged it.
  adminNote  String?
  resolvedBy String?
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

/// A person at a B2B client company who can sign in to the portal.
///
/// WHY THIS EXISTS. A B2BClient row was the whole account: one username, one
/// password, one company. Everybody at the firm shared it. That is why the
/// portal had no settings screen worth building — there was nothing to
/// administer, and no way to answer "who signed in on Tuesday" beyond "the
/// company did". It also meant the only way to remove somebody's access was to
/// change the password on everybody at once, which is the exact event that
/// started the credential audit work in services/credentials.ts.
///
/// A seat is a person. Removing one removes one. The company's own owner does
/// that, in the portal, without filing a ticket with us.
///
/// The B2BClient row remains the account and its username is still a valid
/// login — that login is the owner and cannot be removed, because an account
/// that can lock itself out is an account we get a support call about.
model B2BMember {
  id           String    @id @default(cuid())
  clientId     String
  /// Unique across the whole table, not per client: it is typed into the same
  /// login box as a B2BClient username, so two companies cannot both have an
  /// "analyst".
  username     String    @unique
  name         String
  email        String?
  /// owner | admin | analyst. owner and admin can manage seats; analyst reads.
  role         String    @default("analyst")
  passwordHash String
  /// Kept rather than deleted when access is withdrawn, so the activity log
  /// still resolves the name of whoever did something last month.
  disabled     Boolean   @default(false)
  lastAccessAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([clientId])
}

/// An API key this platform uses, held in the database instead of the host's
/// environment panel.
///
/// WHY THIS TABLE EXISTS. Every provider key lived in one hosting provider's
/// environment variables, which made that provider load-bearing for a reason
/// that has nothing to do with running a container: leaving it meant re-typing
/// every key somewhere else, and rotating one meant a redeploy. The keys belong
/// to the platform, so they live with the platform's own data.
///
/// NEVER PLAINTEXT. The value is encrypted with AES-256-GCM before it gets
/// here, under SECRETS_ENCRYPTION_KEY, which stays in the environment and is
/// never written to this database. That is not decoration: this database is
/// shared with another project, and a plaintext key column would be readable by
/// anyone holding any connection string to it. Encrypted, a leak of the
/// database alone yields nothing.
///
/// The three columns after the ciphertext exist so a human can recognise a key
/// without the server ever having to reveal one. See services/platform-secrets.ts.
model PlatformSecret {
  /// The environment variable name, spelled exactly as env.ts declares it —
  /// "CONGRESS_API_KEY". The name is the identity; there is one row per key.
  name String @id

  /// v1:<iv>:<tag>:<ciphertext>, all base64. The name is bound in as additional
  /// authenticated data, so a ciphertext moved to another row fails to decrypt
  /// rather than quietly becoming a different key.
  ciphertext String

  /// First four hex characters of SHA-256(plaintext) — the same fingerprint the
  /// key report shows, so "what I pasted" and "what the server holds" can be
  /// compared without either side naming the value.
  fingerprint String
  /// Character count of the plaintext. A half-pasted key is a real failure and
  /// an invisible one.
  length      Int

  /// Who set it, copied in rather than joined so the record survives the
  /// account being closed.
  updatedById String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

/// An administrative role, and exactly what it is allowed to do.
///
/// WHY THIS IS A TABLE. The platform shipped with three fixed roles whose
/// powers were spelled out in fourteen scattered `role !== "superadmin"`
/// checks. Changing what a moderator could do meant a code change and a deploy,
/// and no two deployments could differ. Roles are now rows, so the person who
/// owns the platform decides what each one means without asking anybody.
///
/// SUPERADMIN IS NOT IN THIS TABLE. It is not a permission set, it is the
/// owner: it always holds everything, it cannot be edited, and it cannot be
/// deleted. That is the property that makes every other row safe to edit —
/// there is always somebody who can undo a mistake, including the mistake of
/// removing your own access. See services/admin-permissions.ts.
model AdminRole {
  /// What is stored on User.role. Lowercase, stable, and never re-used.
  slug String @id

  /// What it is called in the console. Renaming is free; the slug is the identity.
  name        String
  description String?

  /// Capability keys, as JSON. Every one of them names something a route
  /// checks by name — see services/admin-capabilities.ts, which is the only
  /// place they are defined and which tests hold to actually gating something.
  ///
  /// JSON rather than a join table on purpose: this is read on every
  /// authorization check, it is always read whole, and it is never queried
  /// across roles. A join table would be three queries and a cache to answer
  /// what one column already answers.
  capabilities String

  /// Shipped with the platform. Can be edited freely; cannot be deleted, so a
  /// deployment always has somewhere to put an administrator.
  builtIn Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// ARTICLE V — SELF-CORRECTION
//
// Constitution Article V says political power on this platform is borrowed and
// can be recalled. These two tables are the recall.
// ---------------------------------------------------------------------------

/// A proceeding to suspend one person from RECEIVING delegated voice.
///
/// It is deliberately narrow. An impeached leader keeps their account, their
/// followers, their posts, and their own vote — including the right to delegate
/// it to somebody else. The single power removed is the borrowed one: for the
/// length of the suspension, nobody may lend them a vote, and the delegations
/// they held are returned to the people who lent them.
///
/// One open proceeding per leader at a time. Not one platform-wide: a global
/// lock would let anybody shield a real target by opening a frivolous case
/// against a nobody.
model Impeachment {
  id        String @id @default(cuid())
  /// The person accused. Anyone holding at least one active delegation.
  leaderId  String
  /// Who brought it. Must have been delegating to the leader when they filed.
  ///
  /// NULL ONCE THEY CLOSE THEIR ACCOUNT, and the proceeding carries on without
  /// them. It used to cascade: the filer leaving deleted the articles, the
  /// evidence, and every elector's vote in them — so one person walking away
  /// erased other people's participation in a constitutional act they had
  /// nothing to do with.
  ///
  /// The decision, from the owner: a proceeding may survive its filer, and
  /// everyone entitled to vote in it is notified that the filer has closed
  /// their account. Knowing who brought a case is part of judging it, so a
  /// case that quietly loses its origin has to say so rather than read as
  /// though it appeared from nowhere.
  ///
  /// SystemReset.filedById was already built this way — a bare column with no
  /// relation, for the same reason, spelled out in its own comment.
  filedById String?

  /// open | passed | expired
  ///
  /// There is deliberately no "failed". An elector who does not vote is not
  /// voting against — the threshold is two thirds of everyone entitled, so
  /// silence already counts against, and until the window shuts silence is
  /// indistinguishable from a vote not yet cast. A proceeding therefore cannot
  /// be known to have failed early; it either reaches two thirds or the clock
  /// runs out. Anything else would be the platform declaring a result the
  /// people had not yet given.
  status String @default("open")

  /// ARTICLES OF IMPEACHMENT, in the filer's own words. Served on the accused
  /// in-app and by email at the moment proceedings open, and queued for admins.
  /// Admins may act against a bad-faith filer; they may not stop a proceeding.
  grounds  String
  evidence String

  openedAt  DateTime  @default(now())
  /// openedAt + 7 days. A proceeding is not infinitely standing.
  expiresAt DateTime
  /// When the threshold was crossed, or the window closed without it.
  decidedAt DateTime?

  /// The average of every impeaching voter's proposed length, from now.
  /// Null unless status is "passed". Read live — a lapsed suspension needs no
  /// sweep, and a column saying "suspended" that a job forgot to clear is how
  /// a punishment outlives its sentence.
  suspendedUntil DateTime?

  leader   User                 @relation("ImpeachmentLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  filedBy  User?                @relation("ImpeachmentFiler", fields: [filedById], references: [id], onDelete: SetNull)
  electors ImpeachmentElector[]
  /// The audit that ran when the articles were filed, so the accused and the
  /// electorate see the same numbers before anybody votes.
  audits   IntegrityAudit[]

  /// Every read is either "is there one open against this leader" or "is this
  /// leader suspended right now", and both are (leaderId, status).
  @@index([leaderId, status])
  @@index([status, expiresAt])
  @@index([filedById])
}

/// THE FROZEN ELECTORATE. Exactly who could vote, captured when proceedings
/// opened.
///
/// A row here IS the right to vote. No row, no vote — so somebody who delegates
/// to the leader after the filing gets none, which kills the obvious attack in
/// both directions: flooding a leader with sympathetic new delegators to dilute
/// the vote, or brigading in to manufacture a threshold.
///
/// The same rows are the notification list and the denominator, so those three
/// things cannot drift apart.
///
/// Leaving the delegation does not remove the row. They lent power and were
/// harmed while lending it; the freeze already prevents attrition attacks, so
/// nothing is gained by stripping a departing delegator's say.
model ImpeachmentElector {
  id            String @id @default(cuid())
  impeachmentId String
  voterId       String

  /// Null until they vote. Only ever set to a vote FOR impeachment — there is
  /// no "against" ballot, because the threshold is two thirds of everyone
  /// entitled, so silence already counts against.
  votedAt      DateTime?
  /// How long this voter thinks the suspension should run, 1..365 days. The
  /// average of these sets the end date.
  proposedDays Int?

  impeachment Impeachment @relation(fields: [impeachmentId], references: [id], onDelete: Cascade)
  voter       User        @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([impeachmentId, voterId])
  @@index([voterId])
}

/// A vote to restart the platform's collective memory.
///
/// Article V's other remedy, and the heavier one. Where impeachment recalls one
/// person's borrowed power, this returns ALL of it and zeroes every published
/// tally — the Pulse genuinely starts again.
///
/// One at a time, platform-wide. Unlike impeachment there is no per-target
/// scoping to make room for, and two simultaneous resets would be two votes on
/// the same irreversible act.
model SystemReset {
  id String @id @default(cuid())

  /// NO FOREIGN KEY, on purpose. A proceeding that affects every account on the
  /// platform must not disappear because the person who brought it deleted
  /// theirs. Impeachment cascades from its leader because the proceeding is
  /// meaningless without them; this one is not about its filer.
  filedById String

  /// voting | failed | scheduled | executed
  ///
  /// "scheduled" is the 48 hours between the people deciding and the reset
  /// running. Nobody loses their delegations to a vote that closed while they
  /// slept: the result is announced, everybody is told exactly what is about to
  /// be lost, and only then does it happen.
  status String @default("voting")

  /// ARTICLES OF SYSTEM RESET. Queued for admins like Articles of Impeachment,
  /// and shown to every voter before they vote — this is the case being put to
  /// the whole platform, so it is the whole platform's to read.
  grounds  String
  evidence String

  openedAt  DateTime @default(now())
  /// openedAt + 14 days. Two weeks, and it runs the full two weeks: unlike
  /// impeachment there is no early close, because everybody entitled to a say
  /// on wiping the platform should get their full window to take it.
  expiresAt DateTime

  decidedAt    DateTime?
  /// decidedAt + 48 hours. The disclosure period.
  executeAfter DateTime?
  executedAt   DateTime?

  /// How many accounts could vote, frozen when it opened. The denominator for
  /// the participation floor. Frozen so that mass sign-ups during the window
  /// cannot move the bar in either direction; the ballot route independently
  /// refuses accounts created after openedAt, so the count and the electorate
  /// stay the same set.
  eligibleCount Int

  /// Set when an executed reset is put back. See the undo route for why this
  /// exists at all, and why it is the owner's alone.
  revertedAt DateTime?
  revertedBy String?

  ballots            SystemResetBallot[]
  journalDelegations SystemResetJournalDelegation[]
  journalVotes       SystemResetJournalVote[]

  @@index([status])
  @@index([status, expiresAt])
  @@index([status, executeAfter])
}

/// One account, one ballot. Unlike impeachment this has a real "against" side:
/// the threshold is a share of those who turned out, so an opposing vote
/// changes the arithmetic rather than merely declining to help.
model SystemResetBallot {
  id      String  @id @default(cuid())
  resetId String
  voterId String
  support Boolean

  createdAt DateTime @default(now())

  reset SystemReset @relation(fields: [resetId], references: [id], onDelete: Cascade)

  @@unique([resetId, voterId])
  @@index([resetId, support])
}

/// THE JOURNAL — every delegation the reset switched off, by id.
///
/// Written inside the same transaction as the mutation, which is the whole
/// point: a journal written afterwards is a journal that is missing exactly the
/// rows the crash ate. Same shape as MergeJournal, which is the precedent this
/// platform already has for a reversible destructive operation.
model SystemResetJournalDelegation {
  id           String @id @default(cuid())
  resetId      String
  delegationId String

  reset SystemReset @relation(fields: [resetId], references: [id], onDelete: Cascade)

  @@unique([resetId, delegationId])
  @@index([resetId])
}

/// THE JOURNAL — every vote the reset deleted, whole.
///
/// Deleted rather than flagged, deliberately. Every tally, every feed query,
/// every analytic in the app reads GovernmentReferenceVote; a "cleared" flag
/// would have to be honoured by all of them, and the one place that forgot
/// would keep publishing pre-reset numbers with nothing to show it was wrong.
/// Gone means gone everywhere, and the row lives here instead.
///
/// This is also what "restore my own positions" reads. Every row here is a
/// DIRECT vote — delegated voice is computed and never stored — so a citizen
/// restoring from it gets back exactly what they cast themselves, and nothing
/// a delegate cast in their name.
model SystemResetJournalVote {
  id      String @id @default(cuid())
  resetId String

  governmentReferenceId String
  userId                String
  position              String
  isAnonymous           Boolean
  /// The original createdAt, so a restored position keeps its real date rather
  /// than claiming to have been cast on the day it came back.
  castAt                DateTime

  /// Set when this row has been put back, so restoring twice is a no-op rather
  /// than a duplicate-key error.
  restoredAt DateTime?

  reset SystemReset @relation(fields: [resetId], references: [id], onDelete: Cascade)

  @@unique([resetId, governmentReferenceId, userId])
  @@index([resetId, userId])
}

// ---------------------------------------------------------------------------
// THE RIGHT TO AUDIT.
//
// Constitution Article III §2: "Any user or group of users may demand an
// Integrity Audit of a specific vote if there is evidence of bot interference
// or system malfunction." Until this table there was nothing behind that
// sentence at all.
//
// AN AUDIT COUNTS; IT NEVER NAMES. It may look at a record's vote, at a
// leader's own support, or at the electorate of a proceeding, and it may report
// votes, timing and distributions. It may never name a person, list accounts,
// or publish a figure covering fewer than MIN_COHORT people — the same floor
// the district maps use, in services/jurisdiction.ts.
//
// KEPT FOREVER, ON PURPOSE. An audit nobody can point at later is a
// reassurance, not a remedy. A leader who audits their own support builds a
// history they can show; a proceeding carries the audit that ran when it
// opened.
// ---------------------------------------------------------------------------
model IntegrityAudit {
  id String @id @default(cuid())

  /// reference | leader | impeachment | reset
  subjectType String
  subjectId   String

  /// Null when the platform ran it itself, which happens on an impeachment
  /// filing. A citizen asked for every other one. Kept only so somebody cannot
  /// re-run the same audit every second; it is never published.
  requestedById String?

  /// Set when this audit ran because articles were filed, so the proceeding can
  /// show it beside them and nobody defends themselves blind.
  impeachmentId String?

  runAt DateTime @default(now())

  /// One object per check: what it looked at, what it found, and the numbers.
  /// Counts and sentences only — never an account, a username or an email.
  findings Json

  /// True when at least one check found something worth a person reading. An
  /// audit never accuses; this only says "look here".
  flagged Boolean @default(false)

  requestedBy User?        @relation("IntegrityAuditRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  impeachment Impeachment? @relation(fields: [impeachmentId], references: [id], onDelete: Cascade)

  @@index([subjectType, subjectId, runAt])
  @@index([requestedById])
  @@index([impeachmentId])
}

// ---------------------------------------------------------------------------
// THE JUDICIARY — Community Juries. Constitution Article IV.
//
// "Disputes are settled by randomly chosen trusted users."
//
// The report button has existed since the first build and its reports went into
// a queue no screen anywhere showed. This is the branch of government that
// clause promised, and the reports are what it hears.
//
// A JURY IS CHECKABLE AFTERWARDS OR IT IS NOTHING. Every seat ever drawn is
// kept — answered, unanswered, recused, replaced — because a draw nobody can
// walk backwards is a draw nobody should trust. The same rows are what the
// Trust Score reads about showing up.
// ---------------------------------------------------------------------------
model Jury {
  id       String @id @default(cuid())
  /// One jury per report. A second on the same complaint is a retrial nobody
  /// asked for.
  reportId String @unique

  /// WHO IS ACTUALLY ON TRIAL, resolved once at the draw: the author for a post
  /// or a comment, the account itself for an account report. Stored rather than
  /// re-derived, because a post can be deleted and a finding against a person
  /// has to outlive the thing that was reported.
  accusedId String

  /// comment | post | leader — what was reported, which sets the panel size.
  panelKind     String
  /// 5 for a comment or an ordinary member's post, 7 for a civil leader's.
  seats         Int
  /// 3 of 5, or 4 of 7.
  votesToDecide Int

  /// drawing | deliberating | decided | abandoned
  status  String  @default("drawing")
  /// upheld | dismissed. Null until decided.
  verdict String?

  /// How many delegations the accused held when the jury was drawn, frozen.
  /// Somebody who crosses fifty mid-case does not change the size of the panel
  /// already hearing it.
  accusedDelegations Int @default(0)

  openedAt  DateTime  @default(now())
  decidedAt DateTime?

  report   Report     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  accused  User       @relation("JuryAccused", fields: [accusedId], references: [id], onDelete: Cascade)
  seatRows JurySeat[]

  @@index([status, openedAt])
  @@index([accusedId, verdict])
}

/// One summons. Kept whatever becomes of it.
model JurySeat {
  id      String @id @default(cuid())
  juryId  String
  jurorId String

  /// summoned | accepted | voted | lapsed | recused
  ///
  /// "accepted" is the state that sequesters an account, and it is read live
  /// rather than mirrored onto the user row: a flag saying "sequestered" that a
  /// job forgot to clear is how somebody gets locked out of their own account.
  state String @default("summoned")

  summonedAt DateTime  @default(now())
  acceptedAt DateTime?

  /// uphold | dismiss
  vote      String?
  /// Why. Required to vote — a verdict nobody had to explain is a verdict
  /// nobody can answer.
  reasoning String?
  votedAt   DateTime?

  recusedReason String?
  closedAt      DateTime?

  /// The seat this one was drawn to replace, so the draw can be walked
  /// backwards afterwards.
  replacesSeatId String?

  jury  Jury @relation(fields: [juryId], references: [id], onDelete: Cascade)
  juror User @relation(fields: [jurorId], references: [id], onDelete: Cascade)

  @@unique([juryId, jurorId])
  @@index([jurorId, state])
  @@index([juryId, state])
  @@index([state, summonedAt])
  @@index([state, acceptedAt])
}

/// A thing that broke, is still broken, and is being worked around.
///
/// WHY THIS EXISTS, in the owner's words: "whatever is happening keeps
/// happening again and makes it fail. there needs to be redundancies in
/// place", and "when the initial method fails its reported to the admin and
/// falls back on the redundancy til I've had time to address the initial
/// failure."
///
/// The Citizen's Brief went down three times because the model name it called
/// stopped being served. Each time it failed silently to a message that said
/// "try again shortly" — advice that could never come true — and the only
/// record was a log line on a host nobody was watching.
///
/// A fallback that nobody is told about is a slow secret. The platform keeps
/// running on the safety net, and this row is the thing that says so, until a
/// person acknowledges it.
model ServiceIncident {
  id String @id @default(cuid())

  /// What kind of failure. "ai_model_unusable" today; the shape is deliberately
  /// general so the next thing that needs a safety net does not need a table.
  kind String

  /// What specifically failed — a model name, a provider, a host. With `kind`
  /// this is the identity: the same failure recurring updates one row rather
  /// than writing thousands.
  subject String

  /// What is carrying the load instead. Null when nothing could.
  fallback String?

  /// The provider's own words, trimmed. Never a key, never a prompt.
  detail String

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  /// How many times since it was first seen, or since it was last acknowledged.
  occurrences Int      @default(1)

  /// Set when a person has seen it. An acknowledged incident that happens again
  /// re-opens, because "I have seen this" is not "this has stopped".
  acknowledgedAt DateTime?
  acknowledgedBy String?

  @@unique([kind, subject])
  @@index([acknowledgedAt, lastSeenAt])
}


/// A link that reads the bug queue, and nothing else.
///
/// The bug reporter is where the owner writes down what needs fixing, and
/// getting that list to whoever does the fixing meant signing into the admin
/// panel and copying it out by hand every time. The obvious shortcut — handing
/// over an admin password — grants everything, forever, to solve a problem that
/// is reading one table.
///
/// This is a capability, not an account. It carries no identity, it cannot
/// write anything, and it cannot see any other part of the platform. It
/// expires, and it can be revoked the moment it is not wanted.
///
/// The token is never stored, only its digest — the same treatment a B2B
/// client's API key gets — so this table leaking does not hand anybody a
/// working link. The plaintext is shown once, at creation.
model BugReportReadLink {
  id          String @id @default(cuid())
  /// SHA-256 of the token. Unique, so verifying one is a single indexed read.
  tokenHash   String @unique
  /// What it is for, in the owner's words. A link nobody can identify is a
  /// link nobody dares revoke.
  label       String
  /// Enough to recognise a token without being enough to use one.
  fingerprint String

  createdById String
  createdBy   String
  createdAt   DateTime @default(now())
  /// Every link ends. A link with no expiry is a password with extra steps.
  expiresAt   DateTime

  revokedAt DateTime?
  revokedBy String?

  /// So the owner can see it being used, and notice if it is used when it
  /// should not be. A capability nobody can audit is one nobody should issue.
  lastUsedAt DateTime?
  useCount   Int       @default(0)

  @@index([createdAt])
}
