# Backend (Bun + Hono + Prisma). Copy to .env and fill in.
# NEVER commit the filled-in file — this repository is public.

PORT=3000

# --------------------------------------------------------------------------
# Database — Supabase Postgres
# --------------------------------------------------------------------------
# src/env.ts and prisma/schema.prisma read SUPABASE_DATABASE_URL, not
# DATABASE_URL. That indirection existed because the Vibecode backend template
# overwrote DATABASE_URL with a local SQLite path in production. The template is
# gone now, so this can be collapsed to plain DATABASE_URL whenever you update
# the deployment env — see db/README.md. Until then, set both.
#
# Pooled connection (pgbouncer, port 6543) — used by the app at runtime.
SUPABASE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=10
# Direct connection (port 5432) — used by prisma migrate.
SUPABASE_DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Kept in sync for tools that expect the conventional names.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=10
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# --------------------------------------------------------------------------
# Supabase API
# --------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# service_role key — full admin, bypasses row-level security.
# Server-side only. Never expose this to a browser or ship it in an app bundle.
SUPABASE_SERVICE_KEY=

# --------------------------------------------------------------------------
# Auth
# --------------------------------------------------------------------------
# Better Auth signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --------------------------------------------------------------------------
# Third-party APIs
# --------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
# Free key: https://api.congress.gov/sign-up/
CONGRESS_API_KEY=
COURTLISTENER_API_KEY=
TAVILY_API_KEY=
