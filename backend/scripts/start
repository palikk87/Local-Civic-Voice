#!/bin/bash
set -o errexit
set -o nounset
set -o pipefail

# Civic Voice API boot script.
#
# Host-agnostic by design. It runs identically under Docker (see ../Dockerfile),
# on Railway, Render, Fly, or a bare VPS, and with `bash scripts/start` on a
# laptop. It reads only ordinary environment variables — no platform SDK, no
# magic host-injected names, nothing that ties this app to one vendor.
#
# NODE_ENV is the only mode switch. Set it to "production" on a deployment.

NODE_ENV="${NODE_ENV:-development}"
export NODE_ENV

echo "Starting in ${NODE_ENV} mode..."

# Dependencies are installed at image build time in Docker. Only install here
# when they are actually missing, so a container restart is not a reinstall.
if [[ ! -d "node_modules" ]]; then
  echo "Installing dependencies..."
  bun install --frozen-lockfile
fi

if [[ -f "prisma/schema.prisma" ]]; then
  echo "Generating Prisma client..."
  bunx prisma generate

  # There is one migration and it builds the schema from empty, so this single
  # command brings up a brand new database and is a no-op on an existing one.
  #
  # Never `prisma db push` here. It makes the database match the local schema by
  # any means available, including dropping columns and tables. This project has
  # the receipts: a boot-time push destroyed 423 rows of User.banned and dropped
  # the AdminSession table repeatedly. A CI job fails the build if that command
  # reappears anywhere in the repo, which is where that guard belongs — checking
  # for it here only ever caught the file it was written in.
  echo "Applying migrations..."
  bunx prisma migrate deploy
fi

# exec so the server is PID 1 and receives SIGTERM directly; without it the
# shell swallows the signal and the platform has to SIGKILL on every deploy.
if [[ "${NODE_ENV}" == "production" ]]; then
  echo "Starting server..."
  exec bun src/index.ts
else
  echo "Starting server with hot reload..."
  exec bun --hot src/index.ts
fi
